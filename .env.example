# Copy to .env and fill in real values for local dev. Never commit a real
# .env -- the pre_tool_guard hook (.claude/hooks/pre_tool_guard.py) blocks
# writes to real .env files for exactly this reason.
#
# Values below match docker-compose.yml's service hostnames (postgres,
# valkey, web). Running a service directly on the host instead of in
# Docker? Swap those hostnames for localhost.

ENV=development

# --- Database (Alembic-owned tables + Better Auth's own tables share this DB) ---
DATABASE_URL=postgresql://volley:volley@localhost:5432/volley

# --- Valkey: Celery broker/result backend + cache. Never a source of truth. ---
VALKEY_URL=redis://localhost:6379/0

# --- Auth: services/api verifies Better Auth's JWTs via JWKS, never a shared secret ---
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=volley-api

# Dev-only escape hatch so the API can be exercised before Better Auth is
# fully wired end-to-end -- see app/core/auth.py's Settings docstring.
# MUST be false/unset anywhere reachable by anyone but the developer running it.
DEV_AUTH_BYPASS=false

CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-real-random-secret-before-running-locally
