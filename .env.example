# Copy to .env and fill in real values for local dev. Never commit a real
# .env -- the pre_tool_guard hook (.claude/hooks/pre_tool_guard.py) blocks
# writes to real .env files for exactly this reason.
#
# Values below match docker-compose.yml's service hostnames (postgres,
# valkey, web). Running a service directly on the host instead of in
# Docker? Swap those hostnames for localhost.

ENV=development

# --- Database (Alembic-owned tables + Better Auth's own tables share this DB) ---
DATABASE_URL=postgresql://volley:volley@localhost:5432/volley

# --- Valkey: Celery broker/result backend + cache. Never a source of truth. ---
VALKEY_URL=redis://localhost:6379/0

# --- Auth: services/api verifies Better Auth's JWTs via JWKS, never a shared secret ---
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=volley-api

# Dev-only escape hatch so the API can be exercised before Better Auth is
# fully wired end-to-end -- see app/core/auth.py's Settings docstring.
# MUST be false/unset anywhere reachable by anyone but the developer running it.
DEV_AUTH_BYPASS=false

CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Storage (StorageAdapter, Phase 4 -- see CLAUDE.md's Storage fixed
# decision, docs/architecture/DATA_FLOW.md's upload lifecycle, and
# packages/storage-py) ---
STORAGE_BACKEND=local
MAX_VIDEO_UPLOAD_BYTES=21474836480
LOCAL_UPLOAD_MAX_BYTES=2147483648
DB_HEALTHCHECK_TIMEOUT_SECONDS=2
LOCAL_STORAGE_DIR=/tmp/volley-local-storage
LOCAL_STORAGE_BASE_URL=http://localhost:8000
# Generate with: openssl rand -base64 32 -- signs the local-dev stand-in for
# a real presigned upload URL. Never used in production (STORAGE_BACKEND=r2
# there uses R2's own real presigned URLs instead).
LOCAL_STORAGE_SIGNING_SECRET=replace-with-a-real-random-secret-before-running-locally

# R2 (Cloudflare, S3-compatible) -- production only, unset in dev. No real
# account/credentials exist in this project yet; see
# packages/storage-py/src/volley_storage/r2.py and TECH_DEBT.md.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-real-random-secret-before-running-locally
