# --- Generated contracts (packages/contracts) ---
# These are generated, committed build inputs. CI regenerates them and
# rejects drift so Docker/fresh checkouts never depend on hidden local files.

# --- Node / Next.js (apps/web) ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.pnpm-store/

# --- Python (services/api, services/worker, ml/*) ---
__pycache__/
*.pyc
.venv/
.uv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Stray tmp-dir fixtures some dataset_factory tests write relative to cwd
# instead of pytest's own tmp_path -- never intentional source, wherever
# they land in the tree.
.pytest-dataset*/

# --- Env / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Data / media (never committed; see docs/architecture/DATA_FLOW.md) ---
*.mp4
*.mov
*.mkv
*.avi
data/raw/
data/proxy/
data/frames/
*.pt
*.pth
*.onnx
*.engine
mlruns/
.dvc/cache/
.dvc/tmp/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Logs ---
*.log
logs/

# --- Claude Code runtime state (session-local, never shared) ---
.claude/scheduled_tasks.lock
.claude/*.lock

# --- DVC local-dev remote (Phase 4) -- a plain directory standing in for a
# real S3/R2 remote until production credentials exist; never shared, never
# committed. See docs/datasets/README.md. Also excludes local venvs
# created by `uv sync` inside tools/* packages that sit outside the main
# workspace. ---
/.dvc-local-remote/
tools/*/.venv/
